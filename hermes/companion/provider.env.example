# Ejemplo ficticio; NO es un provider.env operativo ni contiene credenciales.
# Nombres tomados de Settings.from_env; el launcher histórico sobrescribe varios.
HERMES_HA_TOKEN=example-only-not-a-real-token-0123456789abcdef
HERMES_HA_HOST=127.0.0.1
HERMES_HA_PORT=8765
HERMES_SOURCE=/path/to/user/hermes-agent
HERMES_HOME=/path/to/user/.hermes
HERMES_PROFILE=default
HERMES_API_URL=http://192.0.2.10:8642
HERMES_API_TOKEN=example-only-not-a-real-api-token-0123456789abcdef
HERMES_API_SESSION_KEY=example-conversation
HERMES_HA_TEMP_DIR=/path/to/user/snapshot-scratch
HERMES_HA_JSON_LIMIT=262144
HERMES_HA_INFERENCE_TEXT_LIMIT=32768
HERMES_HA_TTS_TEXT_LIMIT=32768
HERMES_HA_STT_UPLOAD_LIMIT=26214400
HERMES_HA_TTS_AUDIO_LIMIT=26214400
HERMES_HA_CONCURRENCY=4
HERMES_HA_REQUEST_TIMEOUT=120
HERMES_HA_BUSY_TIMEOUT=0.05
# API_SERVER_KEY es el nombre que run_provider.py busca en el .env EXTERNO.
# No se incluye ni se crea ese .env; no confundirlo con HERMES_API_TOKEN.
